{
  "$schema": "https://schema.tauri.app/config/3",
  "productName": "Lumina Code CEF",
  "mainBinaryName": "lumina-code-cef",
  "version": "0.3.0",
  "identifier": "com.iewnfod.lumina-code-cef",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../.. build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumina Code",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 500,
        "transparent": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
