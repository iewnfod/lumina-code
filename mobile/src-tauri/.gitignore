# Generated by Cargo / tauri-cli; will have compiled artifacts
/target/

# Generated by Tauri: schema files for capabilities auto-completion
/gen/schemas

# The generated mobile projects: SOURCES are committed (tauri's
# convention — gen/android and gen/ios scaffold the Studio/Xcode
# projects), build outputs are not.
gen/android/.gradle/
gen/android/app/build/
gen/android/build/
gen/android/local.properties
gen/ios/Pods/
gen/ios/build/
# The CLI regenerates this copy on every ohos build (it bakes the
# current devUrl — including the LAN-IP dev overlay), same as android's
# untracked build assets.
gen/ohos/assets/
